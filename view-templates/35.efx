					0 WITH ND-EEDProcurementDetailsLotResult DISPLAY #{BT-811(b)-LotResult} (#{BT-811(a)-LotResult}) ; // Specific EED Item
						WITH BT-812-LotResult DISPLAY #{name}: #value; // Energy Efficiency Label
						WITH BT-813-LotResult DISPLAY #{name}: $value; // Energy Consumption in kWh/year
						WITH BT-814-LotResult DISPLAY #{name}: $value; // Energy Savings in kWh/year
						WITH BT-815-LotResult DISPLAY #{name}: $value; // Energy Efficiency Quantity
				0 WITH ND-IPILotResult DISPLAY #{auxiliary|text|international-procurement-instrument-statistics}; // IPI Measures
					0 WITH ND-IPIAppliedMeasure DISPLAY #{BT-685-LotResult}; // IPI-${count(for text:$lrid in OPT-322-LotResult return preceding::BT-687-LotResult[OPT-322-LotResult == $lrid]) + 1}: // Specific IPI Measure
						WITH BT-686-LotResult DISPLAY #{name} $value; // Number of tender applications that fall under this IPI Measure
						WITH BT-687-LotResult DISPLAY #{name} #{BT-687-LotResult}: ; // Exception to the application of the IPI Measure
						WITH ND-IPIAppliedMeasure[BT-688-LotResult is present] DISPLAY #{field|name|BT-688-LotResult}: ${BT-688-LotResult:preferredLanguageText}; // Overriding reasons relating to the public interest
8 WITH ND-Root DISPLAY #{auxiliary|text|organisations}; // 8 Organisations
	1 WITH ND-Organization, 
	       text:$orgid = OPT-200-Organization-Company, 
	       text*:$tpoid = OPT-201-Organization-TouchPoint,
	       text*:$uboid = OPT-302-Organization, 
	       indicator:$org_is_tenderer = if (($orgid in OPT-300-Tenderer) or ($orgid in OPT-301-Tenderer-SubCont)) then TRUE else FALSE,
	       text*:$lotswon = distinct-values(for text:$tpaid in OPT-210-Tenderer[$orgid in OPT-300-Tenderer], 
	                                       text:$tenderid in OPT-321-Tender[OPT-310-Tender == $tpaid], 
	                                       text:$contractid in OPT-315-LotResult[$tenderid in BT-3202-Contract], 
	                                       text:$lrid in OPT-322-LotResult[ $tenderid in OPT-320-LotResult[$contractid in OPT-315-LotResult]], 
	                                       text:$lotid in BT-13713-LotResult[OPT-322-LotResult == $lrid] return $lotid) 
	DISPLAY ${OPT-200-Organization-Company}  ${$lotswon}; // 8.1 Organisation Technical Identifier
		WITH ND-Organization WHEN BT-500-Organization-Company:isMasked DISPLAY #{field|name|BT-500-Organization-Company}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{field|name|BT-500-Organization-Company}: ${BT-500-Organization-Company:preferredLanguageText} ; // Organisation Name
		WITH BT-165-Organization-Company WHEN BT-165-Organization-Company:isMasked DISPLAY #{field|name|BT-165-Organization-Company}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{name}: #{${concat('code|name|economic-operator-size.', BT-165-Organization-Company)}} ; // Size of the economic operator
		WITH BT-633-Organization WHEN BT-633-Organization == FALSE and 'eop-info' in BT-195-notice DISPLAY #{field|name|BT-633-Organization}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{field|name|BT-633-Organization} ; // The organisation is a natural person
		WITH BT-501-Organization-Company WHEN BT-501-Organization-Company:isMasked DISPLAY #{field|name|BT-501-Organization-Company}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{field|name|BT-501-Organization-Company}: ${BT-501-Organization-Company} ; // Organization Identifier
		WITH BT-16-Organization-Company WHEN BT-16-Organization-Company:isMasked DISPLAY #{name}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{name}: $value; // Organization Part Name
		WITH BT-510(a)-Organization-Company WHEN BT-510(a)-Organization-Company:isMasked DISPLAY #{name}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{name}: ${BT-510(a)-Organization-Company} ${BT-510(b)-Organization-Company} ${BT-510(c)-Organization-Company} ; // Postal address
		WITH BT-513-Organization-Company WHEN BT-513-Organization-Company:isMasked DISPLAY #{name}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{name}: $value; // Organization City
		WITH BT-512-Organization-Company WHEN BT-512-Organization-Company:isMasked DISPLAY #{name}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{name}: $value; // Organization Post Code
		WITH BT-507-Organization-Company WHEN BT-507-Organization-Company:isMasked DISPLAY #{name}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{name}: #{BT-507-Organization-Company} (${BT-507-Organization-Company}) ; // Organization Country Subdivision
		WITH BT-514-Organization-Company WHEN BT-514-Organization-Company:isMasked DISPLAY #{name}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{name}: #value; // Organization Country
		WITH BT-502-Organization-Company WHEN BT-502-Organization-Company:isMasked DISPLAY #{name}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{name}: $value; // Organization Contact Point
		WITH BT-506-Organization-Company WHEN BT-506-Organization-Company:isMasked DISPLAY #{name}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{name}: $value; // Organization Contact Email Address
		WITH BT-503-Organization-Company WHEN BT-503-Organization-Company:isMasked DISPLAY #{name}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{name}: $value; // Organization Contact Telephone Number
		WITH BT-739-Organization-Company WHEN BT-739-Organization-Company:isMasked DISPLAY #{name}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{name}: $value; // Organization Contact Fax
		WITH BT-505-Organization-Company WHEN BT-505-Organization-Company:isMasked DISPLAY #{name}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{name}: $value; // Organization Internet Address
		WITH BT-509-Organization-Company WHEN BT-509-Organization-Company:isMasked DISPLAY #{name}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{name}: $value; // Organization eDelivery Gateway
		WITH BT-508-Procedure-Buyer[OPT-300-Procedure-Buyer == $orgid] DISPLAY #{name}: $value; // Buyer Profile URL
		0 WITH ND-Touchpoint DISPLAY #{auxiliary|text|other-contact-point}:; // TouchPoint / Other contact points
			WITH ND-Touchpoint[BT-500-Organization-TouchPoint is present] DISPLAY #{field|name|BT-500-Organization-TouchPoint}: ${BT-500-Organization-TouchPoint:preferredLanguageText}; // Buyer Touchpoint Name
			WITH BT-16-Organization-TouchPoint DISPLAY #{name}: $value; // Touchpoint Part Name
			WITH BT-510(a)-Organization-TouchPoint DISPLAY #{field|name|BT-510(a)-Organization-TouchPoint}: ${BT-510(a)-Organization-TouchPoint} ${BT-510(b)-Organization-TouchPoint} ${BT-510(c)-Organization-TouchPoint} ; // Touchpoint Postal Address
			WITH BT-513-Organization-TouchPoint DISPLAY #{name}: $value; // Touchpoint City
			WITH BT-512-Organization-TouchPoint DISPLAY #{name}: $value; // Touchpoint Post Code
			WITH BT-507-Organization-TouchPoint DISPLAY #{name}: #{BT-507-Organization-TouchPoint} (${BT-507-Organization-TouchPoint}) ; // Touchpoint Country Subdivision
			WITH BT-514-Organization-TouchPoint DISPLAY #{name}: #value; // Touchpoint Country
			WITH BT-502-Organization-TouchPoint DISPLAY #{name}: $value; // Touchpoint Contact Point
			WITH BT-506-Organization-TouchPoint DISPLAY #{name}: $value; // Touchpoint Contact Email Address
			WITH BT-503-Organization-TouchPoint DISPLAY #{name}: $value; // Touchpoint Contact Telephone Number
			WITH BT-739-Organization-TouchPoint DISPLAY #{name}: $value; // Touchpoint Contact Fax
			WITH BT-505-Organization-TouchPoint DISPLAY #{name}: $value; // Touchpoint Internet Address
			WITH BT-509-Organization-TouchPoint DISPLAY #{name}: $value; // Touchpoint eDelivery Gateway
		0 WITH ND-Organization DISPLAY #{auxiliary|text|roles}:; // Roles of this organisation
			0 WITH ND-Organization[$orgid in OPT-300-Procedure-Buyer] DISPLAY #{auxiliary|text|buyer}; // This org is a Buyer
				WITH OPP-050-Organization[OPP-050-Organization == TRUE] DISPLAY #{name}; // Leader of the group
			WITH OPT-030-Procedure-SProvider['serv-prov' in OPT-030-Procedure-SProvider[($orgid in OPT-300-Procedure-SProvider) or ?exists-common-value($tpoid, OPT-300-Procedure-SProvider)]] DISPLAY #{auxiliary|text|organisation-providing-procurement-service}; // This org is a Service Provider
			WITH OPT-030-Procedure-SProvider['ted-esen' in OPT-030-Procedure-SProvider[($orgid in OPT-300-Procedure-SProvider) or ?exists-common-value($tpoid, OPT-300-Procedure-SProvider)]] DISPLAY #{auxiliary|text|organisation-esender}; // This org is an eSender
			WITH ND-Organization[($orgid in OPT-301-Lot-AddInfo) or ?exists-common-value($tpoid, OPT-301-Lot-AddInfo)] DISPLAY #{auxiliary|text|organisation-providing-info-procedure}; // Additional Information Providing Organisation (LOT)
			WITH ND-Organization[($orgid in OPT-301-Lot-DocProvider) or ?exists-common-value($tpoid, OPT-301-Lot-DocProvider)] DISPLAY #{auxiliary|text|organisation-providing-docs}; // Documents provider organisation (LOT)
			WITH ND-Organization[($orgid in OPT-301-Lot-ReviewOrg) or ?exists-common-value($tpoid, OPT-301-Lot-ReviewOrg)] DISPLAY #{auxiliary|text|organisation-review}; // Review organisation (LOT)
			WITH ND-Organization[($orgid in OPT-301-Lot-ReviewInfo) or ?exists-common-value($tpoid, OPT-301-Lot-ReviewInfo)] DISPLAY #{auxiliary|text|organisation-providing-info-review}; // Organisation providing information on the appeal procedures (LOT)
			WITH ND-Organization[($orgid in OPT-301-Lot-Mediator) or ?exists-common-value($tpoid, OPT-301-Lot-Mediator)] DISPLAY #{auxiliary|text|organisation-mediation}; // Mediation organisation (LOT)
			WITH ND-Organization[($orgid in OPT-301-Lot-FiscalLegis) or ?exists-common-value($tpoid, OPT-301-Lot-FiscalLegis)] DISPLAY #{auxiliary|text|organisation-providing-info-taxes}; // Tax legislation information provider (LOT)
			WITH ND-Organization[($orgid in OPT-301-Lot-EnvironLegis) or ?exists-common-value($tpoid, OPT-301-Lot-EnvironLegis)] DISPLAY #{auxiliary|text|organisation-providing-info-environment}; // Environment legislation information provider (LOT)
			WITH ND-Organization[($orgid in OPT-301-Lot-EmployLegis) or ?exists-common-value($tpoid, OPT-301-Lot-EmployLegis)] DISPLAY #{auxiliary|text|organisation-providing-info-employment}; // Employment legislation information provider (LOT)
			WITH ND-Organization[(OPT-200-Organization-Company in OPT-300-Contract-Signatory) or ?exists-common-value(OPT-201-Organization-TouchPoint, OPT-300-Contract-Signatory)] DISPLAY #{auxiliary|text|organisation-signing-contract}; // Contract Signatory organisation (SettledContract)
			WITH ND-Organization[(OPT-200-Organization-Company in OPT-301-LotResult-Financing) or ?exists-common-value(OPT-201-Organization-TouchPoint, OPT-301-LotResult-Financing)] DISPLAY #{auxiliary|text|organisation-financing}; // Financing Organisation (LotResult)
			WITH ND-Organization[(OPT-200-Organization-Company in OPT-301-LotResult-Paying) or ?exists-common-value(OPT-201-Organization-TouchPoint, OPT-301-LotResult-Paying)] DISPLAY #{auxiliary|text|organisation-paying}; // Paying Organisation (LotResult)
			0 WITH ND-Organization[(OPT-200-Organization-Company in OPT-300-Tenderer) or ?exists-common-value(OPT-201-Organization-TouchPoint, OPT-300-Tenderer)] DISPLAY #{auxiliary|text|organisation-tenderer}; // Tenderer Organisation (Tenderer)
				WITH OPT-170-Tenderer[OPT-300-Tenderer == $orgid] WHEN OPT-170-Tenderer == TRUE DISPLAY #{field|name|OPT-170-Tenderer} WHEN OPT-170-Tenderer == FALSE and 'eop-info' in BT-195-notice DISPLAY #{field|name|OPT-170-Tenderer}: #{auxiliary|text|undisclosed}; // Leader of tendering party
			WITH ND-Organization[(OPT-200-Organization-Company in OPT-301-Tenderer-SubCont) or ?exists-common-value(OPT-201-Organization-TouchPoint, OPT-301-Tenderer-SubCont)] DISPLAY #{auxiliary|text|organisation-subcontractor}; // Subcontractor Organisation (SubContractor)
			0 WITH ND-UBO[OPT-202-UBO in $uboid] DISPLAY #{auxiliary|text|beneficial-owner}; // Beneficial Owner
				WITH BT-500-UBO WHEN BT-500-UBO:isMasked DISPLAY #{name}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{name}: ${concat(OPT-160-UBO, ' ', BT-500-UBO)}; // Beneficial Owner Name
				WITH ND-UBO[BT-706-UBO is present] WHEN 'unpublished' in BT-706-UBO DISPLAY #{field|name|BT-706-UBO}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{field|name|BT-706-UBO}: #{BT-706-UBO}; // Beneficial Owner Nationality (singular)
				WITH BT-510(a)-UBO WHEN BT-510(a)-UBO:isMasked DISPLAY #{name}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{name}: ${concat(BT-510(a)-UBO, ' ', BT-510(b)-UBO, ' ', BT-510(c)-UBO)}; // Beneficial Owner Postal Address
				WITH BT-513-UBO WHEN BT-513-UBO:isMasked DISPLAY #{name}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{name}: $value; // Beneficial Owner City
				WITH BT-512-UBO WHEN BT-500-UBO:isMasked DISPLAY #{name}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{name}: $value; // Beneficial Owner Post Code
				WITH BT-507-UBO WHEN BT-500-UBO:isMasked DISPLAY #{name}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{name}: #{BT-507-UBO} ($value) ; // Beneficial Owner Country Subdivision
				WITH BT-514-UBO WHEN BT-500-UBO:isMasked DISPLAY #{name}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{name}: #{BT-514-UBO}; // Beneficial Owner Country
				WITH BT-506-UBO WHEN BT-500-UBO:isMasked DISPLAY #{name}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{name}: $value; // Beneficial Owner Contact Email Address
				WITH BT-503-UBO WHEN BT-500-UBO:isMasked DISPLAY #{name}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{name}: $value; // Beneficial Owner Telephone Number
				WITH BT-739-UBO WHEN BT-500-UBO:isMasked DISPLAY #{name}: #{auxiliary|text|undisclosed} OTHERWISE DISPLAY #{name}: $value; // Beneficial Owner Fax
			WITH BT-746-Organization[count($lotswon) > 0] WHEN BT-746-Organization == TRUE DISPLAY #{name} WHEN BT-746-Organization == FALSE and 'eop-info' in BT-195-notice DISPLAY #{name}: #{auxiliary|text|undisclosed}; // The winner is listed on a regulated market
10 WITH ND-Root[BT-758-notice is present] DISPLAY #{auxiliary|text|change}; // 10 Change
	WITH BT-758-notice DISPLAY #{name}: $value; // Change Notice Version Identifier
	WITH BT-140-notice DISPLAY #{name}: #value; // Change Reason Code
	WITH ND-ChangeReason[BT-762-notice is present] DISPLAY #{field|name|BT-762-notice}: ${BT-762-notice}; // Change Reason Description
	1 WITH ND-Change DISPLAY #{auxiliary|text|change}; // 10.1 Change
		WITH BT-13716-notice DISPLAY #{name}: $value; // Change Previous Section Identifier
		WITH ND-Change[BT-141(a)-notice is present] DISPLAY #{field|name|BT-141(a)-notice}: ${BT-141(a)-notice}; // Change Description
		WITH BT-719-notice DISPLAY #{field|name|BT-718-notice}: $value; // Change Procurement Documents / Change Procurement Documents Date
11 WITH ND-ReviewRequests DISPLAY #{auxiliary|text|review}; // 11 Review section
	1 WITH ND-ReviewStatus DISPLAY #{field|name|BT-804-Review}: ${BT-804-Review}; // 11.1 Review Technical Identifier
		WITH ND-ReviewStatus DISPLAY #{field|name|BT-784-Review}: ${BT-784-Review}; // Review Identifier
		WITH ND-ReviewStatus[BT-786-Review is present] DISPLAY #{field|name|BT-786-Review}: ${BT-786-Review}; // Review Notice Section Identifier
		WITH ND-ReviewStatus[BT-808-Review is present] DISPLAY #{field|name|BT-808-Review}: ${for text:$orgid in BT-808-Review, text:$orgname in BT-500-Organization-Company[OPT-200-Organization-Company == $orgid] return $orgname}; // Review Applicant Identifier
		WITH ND-ReviewStatus DISPLAY #{field|name|BT-788-Review}: ${BT-788-Review}; // Review Title
		WITH ND-ReviewStatus DISPLAY #{field|name|BT-789-Review}: ${BT-789-Review}; // Review Description
		WITH ND-ReviewStatus DISPLAY #{field|name|BT-787-Review}: ${BT-787-Review}; // Review Date
		WITH ND-ReviewStatus[BT-795-Review is present] DISPLAY #{field|name|BT-795-Review}: ${format-number(BT-795-Review, '###,##0.##')} #{code|name|${concat('currency.', BT-795-Review/@currencyID)}} ; // Review Request Fee
		WITH ND-ReviewStatus[BT-792-Review is present] DISPLAY #{field|name|BT-792-Review}: #{BT-792-Review}; // Review Remedy Type
		WITH ND-ReviewStatus[BT-793-Review is present] DISPLAY #{field|name|BT-793-Review}: ${format-number(BT-793-Review, '###,##0.##')} #{code|name|${concat('currency.', BT-793-Review/@currencyID)}} ; // Review Remedy Value
		WITH ND-ReviewStatus[BT-791-Review is present] DISPLAY #{field|name|BT-791-Review}: #{BT-791-Review}; // Review Irregularity Type
		WITH ND-ReviewStatus DISPLAY #{field|name|BT-783-Review}: #{BT-783-Review}; // Review Request or Decision
		WITH ND-ReviewStatus[BT-790-Review is present] DISPLAY #{field|name|BT-790-Review}: #{BT-790-Review}; // Review Decision Type
		WITH ND-ReviewStatus[BT-785-Review is present] DISPLAY #{field|name|BT-785-Review}: ${BT-785-Review}; // Review Previous Identifier
		WITH ND-ReviewStatus DISPLAY #{field|name|BT-799-ReviewBody}: #{BT-799-ReviewBody}; // Review Body Type
		WITH ND-ReviewStatus[BT-807-Review is present] DISPLAY #{field|name|BT-807-Review}: ${for text:$orgid in BT-807-Review, text:$orgname in BT-500-Organization-Company[OPT-200-Organization-Company == $orgid] return $orgname}; // Review Body Identifier
		WITH ND-ReviewStatus[BT-794-Review is present] DISPLAY #{field|name|BT-794-Review}: ${BT-794-Review}; // Review URL
		WITH ND-ReviewStatus[BT-796-Review == TRUE] DISPLAY #{auxiliary|text|review-request-withdrawn}; // Review Request Withdrawn
		WITH ND-ReviewStatus[BT-798-Review is present] DISPLAY #{field|name|BT-798-Review}: ${BT-798-Review}; // Review Request Withdrawn Reasons
		WITH ND-ReviewStatus[BT-797-Review is present] DISPLAY #{field|name|BT-797-Review}: ${BT-797-Review}; // Review Request Withdrawn Date
0 WITH ND-Root DISPLAY #{auxiliary|text|notice-information}; // Notice information
	WITH BT-701-notice DISPLAY #{name}: ${BT-701-notice} - ${BT-757-notice} ; // Notice identifier / version
	WITH BT-03-notice DISPLAY #{name}: #value; // Form type
	WITH BT-02-notice DISPLAY #{name}: #value; // Notice type
	WITH BT-05(a)-notice DISPLAY #{field|name|BT-05(a)-notice}: ${BT-05(a)-notice} ${BT-05(b)-notice} ; // Notice dispatch date and time
	WITH BT-803(d)-notice DISPLAY #{field|name|BT-803(d)-notice}: ${BT-803(d)-notice} ${BT-803(t)-notice} ; // Notice dispatch date (eSender)
	WITH BT-702(a)-notice DISPLAY #{field|name|BT-702(a)-notice}: #{BT-702(a)-notice} #{BT-702(b)-notice} ; // Languages in which this notice is officially available
	WITH OPP-010-notice DISPLAY #{name}: $value; // Notice publication number
	WITH OPP-011-notice DISPLAY #{name}: $value; // OJ S issue number
	WITH OPP-012-notice DISPLAY #{name}: $value; // Publication date
--- NAVIGATION --- // NAVIGATION
--- SUMMARY --- // SUMMARY
