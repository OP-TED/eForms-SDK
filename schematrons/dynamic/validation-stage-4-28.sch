        <assert id="R-TIM-FW1" role="ERROR" diagnostics="ND-DirectAward_BT-135-Procedure" test="(cbc:ProcessReason) or (not(not(not(cbc:ProcessReasonCode))))">rule|text|R-TIM-FW1</assert>
    </rule>
    <rule context="/*/cac:TenderingTerms/cac:ProcurementLegislationDocumentReference[cbc:ID/text()='LocalLegalBasis']">
