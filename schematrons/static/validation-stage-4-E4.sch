        <assert id="R-DEV-IM8" role="ERROR" diagnostics="ND-EEDProcurementDetailsLotResult_BT-814-LotResult" test="(efac:AssetMetric[efbc:AssetMetricCode/text()='nrg-sav-yr']/efbc:AssetMetricNumeric) or (not((efbc:LegalFrameworkCode) and not(efbc:LegalFrameworkCode/normalize-space(text()) = 'enrg-lab')))">rule|text|R-DEV-IM8</assert>
        <assert id="R-QBD-HMJ" role="ERROR" diagnostics="ND-EEDProcurementDetailsLotResult_BT-815-LotResult" test="(not(efac:StrategicProcurementStatistics/efbc:StatisticsNumeric)) or (not(not(efbc:LegalFrameworkCode)))">rule|text|R-QBD-HMJ</assert>
        <assert id="R-RDQ-35R" role="ERROR" diagnostics="ND-EEDProcurementDetailsLotResult_BT-815-LotResult" test="(efac:StrategicProcurementStatistics/efbc:StatisticsNumeric) or (not(not(not(efbc:LegalFrameworkCode))))">rule|text|R-RDQ-35R</assert>
