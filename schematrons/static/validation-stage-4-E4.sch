        <assert id="R-EDO-Y5P" role="ERROR" diagnostics="ND-EEDProcurementDetailsLotResult_BT-812-LotResult" test="(not(efac:AssetLabel/efbc:LabelCode)) or (not(not(efbc:LegalFrameworkCode/normalize-space(text()) = 'enrg-lab')))">rule|text|R-EDO-Y5P</assert>
        <assert id="R-GHC-RCH" role="ERROR" diagnostics="ND-EEDProcurementDetailsLotResult_BT-812-LotResult" test="(efac:AssetLabel/efbc:LabelCode) or (not(not(not(efbc:LegalFrameworkCode/normalize-space(text()) = 'enrg-lab'))))">rule|text|R-GHC-RCH</assert>
        <assert id="R-IC7-4XL" role="ERROR" diagnostics="ND-EEDProcurementDetailsLotResult_BT-813-LotResult" test="(not(efac:AssetMetric[efbc:AssetMetricCode/text()='nrg-con-yr']/efbc:AssetMetricNumeric)) or (not((not(efbc:LegalFrameworkCode)) or (efbc:LegalFrameworkCode/normalize-space(text()) = 'enrg-lab')))">rule|text|R-IC7-4XL</assert>
        <assert id="R-3F8-NUW" role="ERROR" diagnostics="ND-EEDProcurementDetailsLotResult_BT-813-LotResult" test="(efac:AssetMetric[efbc:AssetMetricCode/text()='nrg-con-yr']/efbc:AssetMetricNumeric) or (not(not((not(efbc:LegalFrameworkCode)) or (efbc:LegalFrameworkCode/normalize-space(text()) = 'enrg-lab'))))">rule|text|R-3F8-NUW</assert>
