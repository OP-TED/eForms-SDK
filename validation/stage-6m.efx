// Notices referred to in OPT-100-Contract.
// The four checks build on each other: each applies only when the previous ones passed,
// so that a notice gets one error, not several.
WITH OPT-100-Contract,
    dynamic : $noticeIsPublished = ?notice-is-published(OPT-100-Contract),
    dynamic : $noticeIsInEformsFormat = ?notice-is-in-eforms-format(OPT-100-Contract),
    dynamic : $noticeHasNoSubsequentChangeNotice = ?notice-has-no-subsequent-change-notice(OPT-100-Contract),
    dynamic : $noticeHasNotBeenCancelled = ?notice-has-not-been-cancelled(OPT-100-Contract)

  // Rule 21: Notice referred to in ‘Framework Notice Identifier’ (OPT-100-Contract) must be published.
  ASSERT $noticeIsPublished
    AS ERROR R-NPB-DVC
    FOR OPT-100-Contract
    IN *;

  // Rule 22: Notice referred to in ‘Framework Notice Identifier’ (OPT-100-Contract) must be published
  //   and in eForms standard.
  WHEN $noticeIsPublished
  ASSERT $noticeIsInEformsFormat
    AS ERROR R-JZ8-LHZ
    FOR OPT-100-Contract
    IN *;

  // Rule 23: Notice referred to in ‘Framework Notice Identifier’ (OPT-100-Contract) must be published,
  //   in eForms standard and cannot have a subsequent Change notice.
  WHEN $noticeIsPublished and $noticeIsInEformsFormat
  ASSERT $noticeHasNoSubsequentChangeNotice
    AS ERROR R-SS8-TXS
    FOR OPT-100-Contract
    IN *;

  // Rule 24: Notice referred to in ‘Framework Notice Identifier’ (OPT-100-Contract) must be published,
  //   in eForms standards, cannot have a subsequent Change notice and cannot be cancelled.
  WHEN $noticeIsPublished and $noticeIsInEformsFormat and $noticeHasNoSubsequentChangeNotice
  ASSERT $noticeHasNotBeenCancelled
    AS ERROR R-BZI-D8T
    FOR OPT-100-Contract
    IN *;
